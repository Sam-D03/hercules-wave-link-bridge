<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>HerculesWaveBridge</AssemblyName>
    <RootNamespace>HerculesWaveBridge</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\hercules-wave-bridge.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Hercules Wave Bridge</Product>
    <Description>Use a Hercules Stream 100 as a physical controller for Elgato Wave Link.</Description>
    <RepositoryUrl>https://github.com/Sam-D03/hercules-wave-link-bridge</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HerculesWaveBridge.Tests" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <ProjectReference
      Include="..\HerculesWaveBridge.FilePicker\HerculesWaveBridge.FilePicker.csproj"
      ReferenceOutputAssembly="false"
      SkipGetTargetFrameworkProperties="true" />
    <None Include="..\..\README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\..\assets\background.png" LogicalName="AtlasLive.background.png" />
  </ItemGroup>
</Project>
